<templates xml:space="preserve">
    <t t-name="nuido_flow_ai_option_model.openai-chat-completion-client-option-model-node" t-inherit="nuido.node" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('node-content')]" position="inside">
            <!-- AI 模型選擇器 (使用 RecordLookupTags) -->
            <div class="mb-2">
                <label t-attf-for="ai-model-selector-{{props.node.id}}">AI 模型</label>
                <RecordLookupTags t-props="aiModelSelectorProps"/>
            </div>
            
            <!-- 傳統下拉選單 (作為備用選項，可選擇是否保留) -->
            <div class="mb-2" t-if="false">
                <label t-attf-id="label-{{props.node.id}}-ai-model" t-att-for="aiModelInputId">模型類型</label>
                <select t-att-id="aiModelInputId" t-on-change.stop.prevent="onAiModelChanged" class="form-control">
                    <option value="qwen2.5-7b-instruct" t-att-selected="selectedModelValue === 'qwen2.5-7b-instruct'">qwen2.5-7b-instruct</option>
                    <option value="gemma-3-4b-it" t-att-selected="selectedModelValue === 'gemma-3-4b-it'">gemma-3-4b-it</option>
                    <option value="hermes-3-llama-3.1-8b" t-att-selected="selectedModelValue === 'hermes-3-llama-3.1-8b'">hermes-3-llama-3.1-8b</option>
                </select>
            </div>
            
            <!-- 顯示當前選中的模型資訊 -->
            <div class="mb-2" t-if="props.node.selectedAiModelName">
                <small class="text-muted">
                    當前模型: <strong t-esc="props.node.selectedAiModelName"/>
                </small>
            </div>
            
            <!-- API 金鑰輸入 -->
            <div class="mb-2">
                <TextInputDialogInput t-key="'api-key-' + props.node.renderVersion.count" id="props.node.id + '-api-key'" label="'API Key'" value="props.node.api_key"
                    onChanged.bind="onApiKeyChanged"
                    hideValue="true"/>
            </div>
            
            <!-- 基礎 URL 輸入 -->
            <div class="mb-2">
                <TextInputDialogInput t-key="'base-url-' + props.node.renderVersion.count" id="props.node.id + '-base-url'" label="'Base URL'" value="props.node.base_url"
                    onChanged.bind="onBaseUrlChanged"/>
            </div>
            
            <!-- 模型詳細資訊顯示 -->
            <div class="mb-2" t-if="props.node.model">
                <small class="text-info">
                    <i class="fa fa-info-circle me-1"/>
                    模型 ID: <code t-esc="props.node.model"/>
                </small>
            </div>
        </xpath>
    </t>
</templates>
